<Window x:Class="GameCompare.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:blazor="clr-namespace:Microsoft.AspNetCore.Components.WebView.Wpf;assembly=Microsoft.AspNetCore.Components.WebView.Wpf"
        xmlns:local="clr-namespace:GameCompare.App"
        Title="GameCompare"
        Width="1240"
        Height="800"
        MinWidth="940"
        MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Background="#111318">
    <Grid>
        <blazor:BlazorWebView HostPage="wwwroot\index.html" Services="{Binding Services}">
            <blazor:BlazorWebView.RootComponents>
                <blazor:RootComponent Selector="#app" ComponentType="{x:Type local:Main}" />
            </blazor:BlazorWebView.RootComponents>
        </blazor:BlazorWebView>
    </Grid>
</Window>
